{
  "expo": {
    "name": "atomic",
    "slug": "atomic",
    "version": "1.0.0",
    "scheme": "atomic",
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "@react-native-async-storage/expo-with-async-storage",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.empiricalhq.atomic"
    },
    "extra": {
      "eas": {
        "projectId": "e99143d8-7b52-4f07-afca-c4dad8cc4b0c"
      }
    }
  }
}
