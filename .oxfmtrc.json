{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSameLine": true,
  "trailingComma": "es5",
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "twMerge"]
  },
  "overrides": [
    {
      "files": ["**/*.md", "**/*.yml", "**/*.yaml", "**/*.json"],
      "options": {
        "printWidth": 80,
        "proseWrap": "always"
      }
    }
  ],
  "ignorePatterns": ["dist/*"]
}
